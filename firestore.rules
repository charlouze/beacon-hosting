rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // §7: a client string with no ceiling is a resource exhaustion paid in
    // euros. Same bound as the one `libs/agent-protocol` already holds.
    function bounded(value) {
      return value is string && value.size() <= 1024;
    }

    function isMember() {
      return request.auth != null
        && exists(/databases/$(database)/documents/members/$(request.auth.uid));
    }

    // The existence test is not redundant with the get(). `get()` on an absent
    // document yields null, and reading `.data` off null fails the evaluation
    // rather than returning false — so without it a visitor would be refused by
    // a crash, and every branch this function sits in would die with it,
    // including the ones that should have passed.
    function isAdmin() {
      return isMember()
        && get(/databases/$(database)/documents/members/$(request.auth.uid)).data.role == 'admin';
    }

    // Checked on create and on update alike: a document validated at birth and
    // left free afterwards is validated nowhere. The three keys are the update
    // path's — on a create the admin's own predicate is narrower, and `steamId`
    // only ever joins the document later, written by its subject.
    //
    // Null is a value this document holds, and §5 is why: every member is
    // enrolled from the Firebase console until the administration screen
    // exists, the first admin included. A console write goes through the Admin
    // SDK, above the rules, and it may legitimately record no address —
    // `{ role, email: null, steamId: null }` is the shape §5 asks for. So
    // demanding a string here would refuse nothing at enrolment and everything
    // after it, starting with that member declaring its own steam id.
    //
    // The opening stops at `update`, which is the only path such a document
    // ever takes: `adminEnrols()` demands an address of its own, so "an admin
    // invites by address" still holds everywhere the rules actually govern
    // enrolment. What `hasAll` holds here is narrower and it is the other half
    // — the keys are there at all, absent and null not reading the same way in
    // a diff.
    function isValidMember(data) {
      return data.keys().hasOnly(['email', 'role', 'steamId'])
        && data.keys().hasAll(['email', 'role'])
        && data.role in ['admin', 'player']
        && (data.email == null || bounded(data.email))
        && (!('steamId' in data) || data.steamId == null || bounded(data.steamId));
    }

    // §5, line 783: the two writers of this document own disjoint fields. An
    // admin enrols and manages — an address and a role; `steamId` is "the
    // subject itself, and nobody else", and enrolling someone with one already
    // filled in declares an identifier that is not one's own. `isValidMember`
    // cannot catch that: the key is a legitimate one, it is its writer that is
    // not.
    function membershipFields() {
      return ['email', 'role'];
    }

    // The two predicates differ in what they are allowed to look at —
    // `resource` is null on a create, so there is no diff to take — and in the
    // address. §5: an admin invites by address, so an enrolment carries a real
    // one. `isValidMember` cannot say that any more, having to accept the null
    // a console enrolment may carry; here it costs nothing, because no console
    // write ever arrives by `create`.
    //
    // The presence test is not redundant with `hasOnly`, which tolerates a
    // missing key: reading an absent one is an evaluation error, and that would
    // refuse an enrolment without an address by crashing instead of deciding.
    function adminEnrols() {
      return isAdmin()
        && request.resource.data.keys().hasOnly(membershipFields())
        && 'email' in request.resource.data
        && bounded(request.resource.data.email);
    }

    function adminManagesMembership() {
      return isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(membershipFields());
    }

    // §5: the subject writes this one field and no other. Opening the document
    // to its subject instead would hand it `role`, which is the privilege
    // escalation §7 names.
    function declaresOwnSteamId(uid) {
      return isMember()
        && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['steamId'])
        && bounded(request.resource.data.steamId);
    }

    match /members/{uid} {
      // Narrower than membership, and deliberately: what this document holds is
      // an email address. A visitor reading its own absent document is how the
      // interface learns it is a visitor.
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow create: if adminEnrols() && isValidMember(request.resource.data);
      allow update: if (adminManagesMembership() || declaresOwnSteamId(uid))
        && isValidMember(request.resource.data);
      allow delete: if isAdmin();
    }

    // §5: the fields of `server/current` have two owners. The client writes
    // intentions, the functions write findings, and the boundary between them is
    // this list — the one the rules demand, declared once and named so that
    // `libs/session-record` can read it as text. Nothing else in the repository
    // can compare it with its two TypeScript counterparts: rules are not
    // TypeScript, and a divergence breaks nothing until an opening is refused
    // every evening, or a reserved fact goes through.
    function demandedFields() {
      return ['state', 'stateSince', 'sessionId', 'startedBy', 'startedAt',
        'deadline', 'game', 'instanceSize'];
    }

    // `instanceSize` is demanded but is not everyone's: §5 makes the template an
    // admin's choice, and a member who writes none inherits the default the
    // function applies from `config/settings`.
    //
    // The order of the last two terms is not indifferent: `isAdmin()` costs a
    // `get()`, and no write but the admin's own needs to pay for it.
    function ownsEveryTouchedField(affected) {
      return affected.hasOnly(demandedFields())
        && (!affected.hasAny(['instanceSize']) || isAdmin());
    }

    // §7: the four fields that say *which* session is open, and in whose name.
    // They move together, with an opening, or they do not move at all.
    function sessionIdentityFields() {
      return ['sessionId', 'game', 'startedBy', 'startedAt'];
    }

    // Every constraint here is conditional, and `stateSince` is the trap: an
    // extension writes `deadline` alone — it does not change the state, so it
    // has no reason to restate when the state began. Demanded unconditionally,
    // `stateSince == request.time` would refuse every extension the product has.
    //
    // No transition table and no arithmetic: which state may follow which is
    // business, it lives in `libs/session`, and the watchdog is what catches a
    // forged order (§4). What the rules hold is that `RUNNING`, `IDLE` and
    // `FAILED` assert a fact only a function can have observed.
    function hasValidValues(affected) {
      let data = request.resource.data;
      // An opening is a write that *moves* the state to PROVISIONING. A state
      // rewritten to the one it already holds does not move, so it opens
      // nothing — which is what keeps a session's identity out of reach for as
      // long as the session lasts.
      let opening = affected.hasAny(['state']) && data.state == 'PROVISIONING';
      return (!affected.hasAny(['state']) || data.state in ['PROVISIONING', 'STOPPING'])
        // `stateSince` is the instant `state` began, so neither is written
        // without the other — and `affectedKeys` only reports what changes,
        // which makes this the check that catches a state rewritten to the one
        // it already holds. One way round it is an attack: a member pushing
        // `stateSince` alone to `request.time`, over and over, holds a stuck
        // provisioning past every timeout the watchdog measures from it. The
        // other way it is a lie left in the document — a new state dated from
        // the previous one.
        && affected.hasAny(['state']) == affected.hasAny(['stateSince'])
        && (!affected.hasAny(['stateSince']) || data.stateSince == request.time)
        // An opening declares all four, and no other write may touch them.
        //
        // Read off the resulting document and never off the affected keys, and
        // that is the same lesson as `state` just above: `clearFacts` clears
        // the reserved facts and nothing else, so a document back to IDLE still
        // carries the name of whoever opened the last session. An opening that
        // simply omits `startedBy` changes it not at all — the key is never
        // affected, no check that watches for movement ever runs, and the
        // session is filed under the previous player. §7 names that refusal.
        //
        // For the same reason this cannot be `affectedKeys().hasAll(...)`:
        // opening a second session of the same game, or a second session by the
        // same player, moves neither field, and every one of those would be
        // refused.
        //
        // `hasAll` comes first so the three tests that follow read keys that
        // exist — an absent one is an evaluation error, which refuses by
        // crashing rather than by deciding.
        && (opening
              ? data.keys().hasAll(sessionIdentityFields())
                && data.startedBy == request.auth.uid
                && data.startedAt == request.time
                && bounded(data.sessionId)
                && bounded(data.game)
              : !affected.hasAny(sessionIdentityFields()))
        // A timestamp and not a bounded string, because this field is the only
        // one a client writes that is not one: left untyped it would take a
        // megabyte like any other.
        && (!affected.hasAny(['deadline']) || data.deadline is timestamp)
        && (!affected.hasAny(['instanceSize']) || bounded(data.instanceSize));
    }

    function isValidServerUpdate() {
      let affected = request.resource.data.diff(resource.data).affectedKeys();
      return ownsEveryTouchedField(affected) && hasValidValues(affected);
    }

    match /server/current {
      // The document is named, never `server/{id}`: any other document of the
      // collection falls through to the refusal below.
      allow read: if isMember();

      // Neither created nor deleted by a client, and that is what holds
      // everything above: `resource` is null on a create, so a document a client
      // could create would be born past every field-by-field check at once —
      // `RUNNING`, with an ip of its own choosing. §5 seeds it at deployment,
      // and it stays.
      allow update: if isMember() && isValidServerUpdate();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
