# Skills matérialisées depuis skills-lock.json — réinstallables, jamais versionnées
.claude/skills/
.agents/skills/

# Réglages locaux de l'agent
.claude/settings.local.json

# Worktrees imbriqués dans l'espace de travail. Un worktree est une copie
# complète, donc chacun de ses projets entre en collision avec celui dont il est
# issu : sans cette ligne, Nx échoue sur MultipleProjectsWithSameNameError et
# plus aucune cible ne se lance — y compris dans l'arbre principal.
/.claude/worktrees/

# IDE
.idea/

# Secrets — rien qui ressemble à une clé OVH ou un compte de service ne remonte
.env
.env.*
!.env.example
*.serviceaccount.json

# Node / Nx / Firebase
node_modules/
dist/
.nx/
.firebase/
*-debug.log
out-tsc/
tmp/
coverage/
test-output/
vitest.config.*.timestamp*

# Fichiers de travail du serveur de questions Impeccable
.impeccable/questions/

.angular

__screenshots__/
