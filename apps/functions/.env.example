# Non-secret Scaleway parameters, read by the watchdog. The secret key is not
# here: it lives in Secret Manager, set by `firebase functions:secrets:set`.
SCW_ACCESS_KEY=
SCW_PROJECT_ID=
SCW_ZONE=fr-par-1

# What the machine may reach in object storage. The s3 secret key is not
# here: it lives in Secret Manager like the others.
#
# Where the machine reports is not here either, and cannot be: it is the url of
# a function the deployment creates, so the deployment writes it itself, on
# `config/settings.agentEndpoint` (§4, §10 étape 5).
S3_ENDPOINT=https://s3.fr-par.scw.cloud
S3_ACCESS_KEY=
SAVES_BUCKET=beacon-saves
GAMES_BUCKET=beacon-games

# Secrets, set with `firebase functions:secrets:set` and never written here:
#   SCW_SECRET_KEY, SERVER_PASSWORD, DYNHOST_USER, DYNHOST_PASSWORD, S3_SECRET_KEY
