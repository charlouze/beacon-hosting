{
  "name": "@beacon/rules-stamp",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "nx": {
    "name": "rules-stamp",
    "tags": ["scope:tool"],
    "targets": {
      "stamp": {
        "executor": "nx:run-commands",
        "options": {
          "command": "npx tsx tools/rules-stamp/src/stamp.ts"
        }
      }
    }
  },
  "dependencies": {}
}
