{
  "name": "@beacon/game-depot",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "nx": {
    "name": "game-depot",
    "tags": ["scope:tool"],
    "targets": {
      "update": {
        "executor": "nx:run-commands",
        "options": {
          "command": "npx tsx tools/game-depot/src/update.ts"
        }
      },
      "push": {
        "executor": "nx:run-commands",
        "options": {
          "command": "npx tsx tools/game-depot/src/push.ts"
        }
      },
      "archive-key": {
        "executor": "nx:run-commands",
        "options": {
          "command": "npx tsx tools/game-depot/src/archive-key.ts"
        }
      }
    }
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "tar": "^7.4.3"
  }
}
