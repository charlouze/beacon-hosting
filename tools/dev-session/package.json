{
  "name": "@beacon/dev-session",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "nx": {
    "name": "dev-session",
    "tags": [
      "scope:tool"
    ],
    "targets": {
      "session": {
        "executor": "nx:run-commands",
        "options": {
          "command": "npx tsx tools/dev-session/src/session.ts"
        }
      }
    }
  },
  "dependencies": {}
}
