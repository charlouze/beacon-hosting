{
  "name": "@beacon/world-depot",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "nx": {
    "name": "world-depot",
    "tags": [
      "scope:tool"
    ],
    "targets": {
      "retrieve": {
        "executor": "nx:run-commands",
        "options": {
          "command": "npx tsx tools/world-depot/src/retrieve.ts"
        }
      },
      "adopt": {
        "executor": "nx:run-commands",
        "options": {
          "command": "npx tsx tools/world-depot/src/adopt.ts"
        }
      }
    }
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@beacon/admin-key": "*",
    "@beacon/cloud-init": "*",
    "tar": "^7.4.3"
  }
}
