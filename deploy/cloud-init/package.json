{
  "name": "@beacon/cloud-init",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "nx": {
    "name": "cloud-init",
    "tags": [
      "scope:catalog"
    ],
    "targets": {
      "render": {
        "executor": "nx:run-commands",
        "options": {
          "command": "npx tsx deploy/cloud-init/src/render.ts"
        }
      },
      "render-compose": {
        "executor": "nx:run-commands",
        "options": {
          "command": "npx tsx deploy/cloud-init/src/render.ts",
          "env": {
            "WHAT": "compose"
          }
        }
      },
      "render-serverid-filter": {
        "executor": "nx:run-commands",
        "options": {
          "command": "npx tsx deploy/cloud-init/src/render.ts",
          "env": {
            "WHAT": "serverid-filter"
          }
        }
      }
    }
  },
  "dependencies": {}
}
