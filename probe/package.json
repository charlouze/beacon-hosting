    "scw:tag": "tsx scaleway/tag-probe.ts",
    "scw:session": "tsx scaleway/session-probe.ts"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "@scaleway/sdk": "^4.0.7",
    "@types/node": "^26.4.1",
    "dotenv": "^16.4.7",
    "firebase": "^11.0.0",
    "firebase-tools": "^13.29.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
