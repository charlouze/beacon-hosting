# Scaleway API key, created in the console under IAM > API keys.
# The real file is probe/.env, which .gitignore already excludes.
SCW_SECRET_KEY=
SCW_PROJECT_ID=
SCW_ZONE=fr-par-1

# Object Storage. The write key stays on the administrator's machine; the VM
# only ever gets the read-only one, per §6 of the spec. At Scaleway an API key's
# access key and secret key are also its S3 credentials — the write pair is the
# one above, repeated here so that the two roles never get confused.
SCW_BUCKET=beacon-saves
SCW_S3_ENDPOINT=https://s3.fr-par.scw.cloud
SCW_S3_REGION=fr-par
SCW_S3_ACCESS_KEY=
SCW_S3_SECRET_KEY=
SCW_S3_RO_ACCESS_KEY=
SCW_S3_RO_SECRET_KEY=
